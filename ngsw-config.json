{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogo",
      "urls": [
        "https://vmxpxsokimlnewrjdcvz.supabase.co/rest/v1/peliculas*",
        "https://vmxpxsokimlnewrjdcvz.supabase.co/rest/v1/generos*",
        "https://vmxpxsokimlnewrjdcvz.supabase.co/rest/v1/funciones*",
        "https://vmxpxsokimlnewrjdcvz.supabase.co/rest/v1/productos*",
        "https://vmxpxsokimlnewrjdcvz.supabase.co/rest/v1/combos*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 60,
        "maxAge": "1d",
        "timeout": "4s"
      }
    },
    {
      "name": "imagenes",
      "urls": ["https://vmxpxsokimlnewrjdcvz.supabase.co/storage/v1/object/public/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "7d"
      }
    }
  ]
}
